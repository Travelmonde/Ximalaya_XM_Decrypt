/* XM 解密工具 TUI 样式 */

Screen {
    background: $surface;
}

Header {
    background: $primary;
    color: $text;
}

Footer {
    background: $panel;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 34;
    padding: 1 2;
    background: $panel;
    border-right: solid $primary-darken-2;
}

#logo {
    text-style: bold;
    color: $accent;
    padding-bottom: 1;
}

#sidebar Button {
    width: 100%;
    margin-bottom: 1;
}

#panel {
    padding: 1 3;
}

.dialog-title {
    text-style: bold;
    color: $accent;
    padding-bottom: 1;
    height: auto;
}

.muted {
    color: $text-muted;
    height: auto;
}

.error {
    color: $error;
    height: auto;
}

/* ---------------- 弹窗容器 ---------------- */
FilePicker, PlanScreen, DirPlanScreen, SettingsScreen, RunScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 92%;
    max-width: 130;
    height: 88%;
    background: $panel;
    border: thick $primary;
    padding: 1 2;
}

.dialog-small {
    width: 80%;
    max-width: 110;
    height: auto;
    max-height: 92%;
    background: $panel;
    border: thick $primary;
    padding: 1 2;
}

.field-row {
    height: 3;
}

.field-row Label {
    width: 14;
    padding-top: 1;
}

.field-row Input {
    width: 1fr;
}

.field-row Button {
    margin-left: 1;
}

.dialog-buttons {
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

.dialog-buttons Button {
    margin-left: 2;
}

/* ---------------- 文件选择器 ---------------- */
#entries {
    height: 1fr;
    border: solid $primary-darken-3;
}

#hint {
    color: $text-muted;
    height: auto;
    padding-top: 1;
}

/* ---------------- 命名确认 ---------------- */
#rows {
    height: 1fr;
    border: solid $primary-darken-3;
    padding: 0 1;
}

.row {
    height: 3;
}

.row .fname {
    width: 42%;
    padding-top: 1;
    color: $text-muted;
    text-overflow: ellipsis;
}

.row Input {
    width: 1fr;
}

/* ---------------- 运行界面 ---------------- */
#bar {
    height: auto;
    padding: 1 0;
}

#log {
    height: 1fr;
    border: solid $primary-darken-3;
}
